<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="orcamento" pageWidth="595" pageHeight="842" columnWidth="515"
              leftMargin="40" rightMargin="40" topMargin="36" bottomMargin="36">
    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="ORDEM_ID" class="java.lang.String"/>
    <parameter name="CLIENTE" class="java.lang.String"/>
    <parameter name="DOCUMENTO" class="java.lang.String"/>
    <parameter name="VEICULO" class="java.lang.String"/>
    <parameter name="PLACA" class="java.lang.String"/>
    <parameter name="STATUS" class="java.lang.String"/>
    <parameter name="TOTAL" class="java.lang.Double"/>
    <field name="name" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="baseCost" class="java.lang.Double"/>
    <title>
        <band height="185">
            <staticText><reportElement x="0" y="0" width="515" height="34" forecolor="#17324D"/><textElement><font size="22" isBold="true"/></textElement><text><![CDATA[Orçamento de Serviço]]></text></staticText>
            <staticText><reportElement x="0" y="43" width="85" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[Ordem:]]></text></staticText>
            <textField><reportElement x="85" y="43" width="430" height="18"/><textFieldExpression><![CDATA[$P{ORDEM_ID}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="67" width="85" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[Cliente:]]></text></staticText>
            <textField><reportElement x="85" y="67" width="430" height="18"/><textFieldExpression><![CDATA[$P{CLIENTE} + "  |  " + $P{DOCUMENTO}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="91" width="85" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[Veículo:]]></text></staticText>
            <textField><reportElement x="85" y="91" width="430" height="18"/><textFieldExpression><![CDATA[$P{VEICULO} + "  |  Placa: " + $P{PLACA}]]></textFieldExpression></textField>
            <staticText><reportElement x="0" y="115" width="85" height="18"/><textElement><font isBold="true"/></textElement><text><![CDATA[Status:]]></text></staticText>
            <textField><reportElement x="85" y="115" width="430" height="18"/><textFieldExpression><![CDATA[$P{STATUS}]]></textFieldExpression></textField>
            <staticText><reportElement mode="Opaque" x="0" y="151" width="310" height="25" backcolor="#EAF0F5"/><textElement verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Serviço]]></text></staticText>
            <staticText><reportElement mode="Opaque" x="310" y="151" width="205" height="25" backcolor="#EAF0F5"/><textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement><text><![CDATA[Valor]]></text></staticText>
        </band>
    </title>
    <detail>
        <band height="42">
            <textField textAdjust="StretchHeight"><reportElement x="0" y="4" width="310" height="34"/><textFieldExpression><![CDATA[$F{name} + "\n" + $F{description}]]></textFieldExpression></textField>
            <textField pattern="¤ #,##0.00"><reportElement x="310" y="4" width="205" height="34"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{baseCost}]]></textFieldExpression></textField>
            <line><reportElement x="0" y="41" width="515" height="1" forecolor="#D5DDE5"/></line>
        </band>
    </detail>
    <summary>
        <band height="55">
            <staticText><reportElement x="250" y="16" width="100" height="25" forecolor="#17324D"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><text><![CDATA[TOTAL:]]></text></staticText>
            <textField pattern="¤ #,##0.00"><reportElement x="355" y="16" width="160" height="25" forecolor="#17324D"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="14" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>
